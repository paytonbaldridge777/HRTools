# Accessibility Scanner Server Configuration
# Copy this file to .env and configure for your environment

# Server Configuration
PORT=3001
NODE_ENV=development

# Security: URL Whitelist (comma-separated, no spaces)
# Only domains in this list can be scanned (SSRF protection)
# For development, include localhost. For production, remove it!
ALLOWED_DOMAINS=localhost,127.0.0.1,law.tamu.edu

# Security: CORS Origins (comma-separated, no spaces)
# Only these origins can access the API
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000

# Optional: Logging level
# LOG_LEVEL=info

# Production Notes:
# - Remove localhost and 127.0.0.1 from ALLOWED_DOMAINS
# - Set ALLOWED_ORIGINS to your production domain(s)
# - Use HTTPS URLs in production
# - Set NODE_ENV=production
