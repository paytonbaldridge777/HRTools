---
const { currentPath = '' } = Astro.props;
---
<header class="tlw-header w-full border-b border-[rgba(255,255,255,0.2)] bg-gradient-to-b from-tamu-maroon to-tamu-maroon-700 text-white shadow-md z-20">
  <div class="max-w-[1800px] mx-auto px-4">
    <div class="flex justify-between items-center h-20">
      <!-- Logo and Title -->
      <a href="/" class="flex items-center gap-4 no-underline">
        <img src="/images/logo.png" alt="HR Tools Logo" class="h-10" />
        <span class="text-2xl font-bold whitespace-nowrap">HR Tools</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-2" aria-label="Main">
        <a 
          class={`tlw-link inline-flex items-center px-3 py-2 border border-transparent rounded-lg text-white no-underline font-medium hover:bg-[rgba(255,255,255,0.1)] hover:border-[rgba(255,255,255,0.2)] ${currentPath.startsWith('/FMLACalculator') ? 'bg-[rgba(255,255,255,0.2)] border-[rgba(255,255,255,0.3)]' : ''}`}
          href="/FMLACalculator/"
          aria-current={currentPath.startsWith('/FMLACalculator') ? 'page' : undefined}
        >
          FMLA Calculator
        </a>
        <a 
          class={`tlw-link inline-flex items-center px-3 py-2 border border-transparent rounded-lg text-white no-underline font-medium hover:bg-[rgba(255,255,255,0.1)] hover:border-[rgba(255,255,255,0.2)] ${currentPath.startsWith('/TrainTraqReminders') ? 'bg-[rgba(255,255,255,0.2)] border-[rgba(255,255,255,0.3)]' : ''}`}
          href="/TrainTraqReminders/"
          aria-current={currentPath.startsWith('/TrainTraqReminders') ? 'page' : undefined}
        >
          TrainTraq Reminders
        </a>
        <a 
          class={`tlw-link inline-flex items-center px-3 py-2 border border-transparent rounded-lg text-white no-underline font-medium hover:bg-[rgba(255,255,255,0.1)] hover:border-[rgba(255,255,255,0.2)] ${currentPath.startsWith('/OnboardingTracker') ? 'bg-[rgba(255,255,255,0.2)] border-[rgba(255,255,255,0.3)]' : ''}`}
          href="/OnboardingTracker/"
          aria-current={currentPath.startsWith('/OnboardingTracker') ? 'page' : undefined}
        >
          Onboarding Tracker
        </a>
        <a 
          class={`tlw-link inline-flex items-center px-3 py-2 border border-transparent rounded-lg text-white no-underline font-medium hover:bg-[rgba(255,255,255,0.1)] hover:border-[rgba(255,255,255,0.2)] ${currentPath.startsWith('/Accessibility') ? 'bg-[rgba(255,255,255,0.2)] border-[rgba(255,255,255,0.3)]' : ''}`}
          href="/Accessibility/"
          aria-current={currentPath.startsWith('/Accessibility') ? 'page' : undefined}
        >
          Accessibility Checker
        </a>
        <button 
          id="theme-toggle" 
          class="inline-flex items-center justify-center px-3 py-2 border border-[rgba(255,255,255,0.3)] rounded-lg bg-[rgba(255,255,255,0.1)] text-xl cursor-pointer transition-all hover:bg-[rgba(255,255,255,0.2)]"
          title="Toggle dark mode" 
          aria-label="Toggle dark mode"
        >
          🌙
        </button>
      </nav>

      <!-- Mobile menu button -->
      <button 
        id="menuBtn" 
        class="tlw-menu-btn md:hidden inline-flex items-center justify-center w-10 h-10 border border-[rgba(255,255,255,0.3)] rounded-lg bg-[rgba(255,255,255,0.1)] text-white"
        aria-expanded="false" 
        aria-controls="mobileMenu" 
        aria-label="Open menu"
      >
        ☰
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav id="mobileMenu" class="tlw-mobile hidden border-t border-[rgba(255,255,255,0.2)] bg-gradient-to-b from-tamu-maroon to-tamu-maroon-700 flex-col gap-1 p-2 pb-4" aria-label="Mobile">
    <a href="/FMLACalculator/" class="block px-4 py-3 rounded-lg text-white no-underline font-medium hover:bg-[rgba(255,255,255,0.1)]">FMLA Calculator</a>
    <a href="/TrainTraqReminders/" class="block px-4 py-3 rounded-lg text-white no-underline font-medium hover:bg-[rgba(255,255,255,0.1)]">TrainTraq Reminders</a>
    <a href="/OnboardingTracker/" class="block px-4 py-3 rounded-lg text-white no-underline font-medium hover:bg-[rgba(255,255,255,0.1)]">Onboarding Tracker</a>
    <a href="/Accessibility/" class="block px-4 py-3 rounded-lg text-white no-underline font-medium hover:bg-[rgba(255,255,255,0.1)]">Accessibility Checker</a>
    <button id="mobile-theme-toggle" class="w-full text-left px-4 py-3 rounded-lg text-white no-underline font-medium hover:bg-[rgba(255,255,255,0.1)]">Toggle Dark Mode</button>
  </nav>
</header>
<script>
  // Script to handle mobile menu and theme toggle
  document.addEventListener('DOMContentLoaded', function () {
    const menuBtn = document.getElementById('menuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', !isExpanded);
      mobileMenu.classList.toggle('hidden');
      mobileMenu.classList.toggle('flex');
    });

    const themeToggle = document.getElementById('theme-toggle');
    const mobileThemeToggle = document.getElementById('mobile-theme-toggle');
    
    const applyTheme = (theme) => {
        if (theme === 'dark') {
            document.documentElement.classList.add('dark');
            themeToggle.textContent = '☀️';
        } else {
            document.documentElement.classList.remove('dark');
            themeToggle.textContent = '🌙';
        }
    };

    const currentTheme = localStorage.getItem('theme') || 'light';
    applyTheme(currentTheme);

    const toggleFn = () => {
        const newTheme = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
        localStorage.setItem('theme', newTheme);
        applyTheme(newTheme);
    };

    themeToggle.addEventListener('click', toggleFn);
    mobileThemeToggle.addEventListener('click', toggleFn);
  });
</script>
