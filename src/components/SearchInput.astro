---
// SearchInput component for client-side filtering
---

<div class="search-container mb-6">
  <div class="relative">
    <input
      type="text"
      id="search-input"
      placeholder="Search tools..."
      class="w-full px-4 py-3 pl-12 bg-[var(--input-bg)] border border-[var(--border-color)] rounded-lg text-[var(--text-primary)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:ring-2 focus:ring-tamu-maroon"
      aria-label="Search tools"
    />
    <svg 
      class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-[var(--text-tertiary)]" 
      fill="none" 
      stroke="currentColor" 
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </div>
</div>

<script>
  function initSearch() {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const toolCards = document.querySelectorAll('.tool-card');

    if (!searchInput) return;

    // Debounce function
    let debounceTimer: number;
    const debounce = (callback: () => void, delay: number) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(callback, delay);
    };

    searchInput.addEventListener('input', () => {
      debounce(() => {
        const searchTerm = searchInput.value.toLowerCase().trim();

        toolCards.forEach((card) => {
          const cardElement = card as HTMLElement;
          const text = cardElement.textContent?.toLowerCase() || '';
          
          if (searchTerm === '' || text.includes(searchTerm)) {
            cardElement.style.display = '';
            cardElement.classList.remove('hidden');
          } else {
            cardElement.style.display = 'none';
            cardElement.classList.add('hidden');
          }
        });

        // Show "no results" message if all cards are hidden
        const visibleCards = Array.from(toolCards).filter(
          card => !(card as HTMLElement).classList.contains('hidden')
        );

        let noResultsMsg = document.getElementById('no-results');
        if (visibleCards.length === 0 && searchTerm !== '') {
          if (!noResultsMsg) {
            noResultsMsg = document.createElement('div');
            noResultsMsg.id = 'no-results';
            noResultsMsg.className = 'col-span-full text-center py-12 text-[var(--text-secondary)]';
            noResultsMsg.innerHTML = `
              <p class="text-lg mb-2">No tools found</p>
              <p class="text-sm">Try adjusting your search term</p>
            `;
            document.querySelector('.tools-grid')?.appendChild(noResultsMsg);
          }
          noResultsMsg.style.display = 'block';
        } else if (noResultsMsg) {
          noResultsMsg.style.display = 'none';
        }
      }, 300);
    });
  }

  // Initialize on page load
  initSearch();

  // Reinitialize after navigation
  document.addEventListener('astro:page-load', initSearch);
</script>
