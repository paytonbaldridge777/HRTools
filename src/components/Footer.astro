---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--border-color)] bg-[var(--bg-secondary)] py-8">
  <div class="container max-w-[1120px] mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- About -->
      <div>
        <h3 class="font-bold text-lg mb-3 text-[var(--text-primary)]">HR Tools</h3>
        <p class="text-sm text-[var(--text-secondary)]">
          A suite of internal tools for HR operations at TAMU School of Law.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="font-bold text-lg mb-3 text-[var(--text-primary)]">Tools</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/tools/fmla-calculator" class="text-[var(--text-secondary)] hover:text-tamu-maroon transition-colors">
              FMLA Calculator
            </a>
          </li>
          <li>
            <a href="/tools/traintraq-reminders" class="text-[var(--text-secondary)] hover:text-tamu-maroon transition-colors">
              TrainTraq Reminders
            </a>
          </li>
          <li>
            <a href="/tools/onboarding-tracker" class="text-[var(--text-secondary)] hover:text-tamu-maroon transition-colors">
              Onboarding Tracker
            </a>
          </li>
        </ul>
      </div>

      <!-- Support -->
      <div>
        <h3 class="font-bold text-lg mb-3 text-[var(--text-primary)]">Support</h3>
        <p class="text-sm text-[var(--text-secondary)] mb-2">
          Need help? Contact HR at TAMU School of Law.
        </p>
        <p class="text-xs text-[var(--text-tertiary)]">
          Version 1.0.0
        </p>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-[var(--border-color)] text-center text-sm text-[var(--text-tertiary)]">
      <p>© {currentYear} Texas A&M University School of Law. All rights reserved.</p>
    </div>
  </div>
</footer>
