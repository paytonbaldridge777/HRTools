---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Onboarding Tracker - HR Tools">
  <div class="container max-w-[1120px] mx-auto px-4 py-12">
    <!-- Onboarding Tracker App Container -->
    <div id="onboarding-root" class="bg-[var(--card-bg)] border border-[var(--border-color)] rounded-lg shadow-sm overflow-hidden">
      <iframe 
        src="/OnboardingTracker/index.html" 
        class="w-full border-0"
        style="min-height: 800px;"
        title="Onboarding Tracker Tool"
      ></iframe>
    </div>

    <!-- Instructions -->
    <div class="mt-8 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-6">
      <h2 class="text-xl font-bold text-blue-900 dark:text-blue-100 mb-3">How to Use</h2>
      <ul class="list-disc list-inside space-y-2 text-blue-800 dark:text-blue-200">
        <li>View dashboard with active, completed, and overdue onboardings</li>
        <li>Create new onboarding records for employees</li>
        <li>Track HR tasks and completion dates</li>
        <li>Generate onboarding emails and documentation</li>
        <li>Monitor analytics by hire type and category</li>
      </ul>
    </div>
  </div>
</BaseLayout>

<script>
  // Track tool usage in localStorage
  function trackToolUsage() {
    const recentTools = JSON.parse(localStorage.getItem('recentTools') || '[]');
    const toolSlug = 'onboarding-tracker';
    
    const filtered = recentTools.filter((slug: string) => slug !== toolSlug);
    filtered.unshift(toolSlug);
    const updated = filtered.slice(0, 5);
    
    localStorage.setItem('recentTools', JSON.stringify(updated));
  }

  trackToolUsage();
</script>
