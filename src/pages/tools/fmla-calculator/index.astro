---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="FMLA Calculator - HR Tools">
  <div class="container max-w-[1600px] mx-auto px-4 py-12">
    <!-- FMLA Calculator App Container -->
    <div id="fmla-calculator-root" class="bg-[var(--card-bg)] border border-[var(--border-color)] rounded-lg shadow-sm overflow-hidden">
      <iframe 
        src="/FMLACalculator/index.html" 
        class="w-full border-0"
        style="min-height: 800px;"
        title="FMLA Calculator Tool"
      ></iframe>
    </div>

    <!-- Instructions -->
    <div class="mt-8 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-6">
      <h2 class="text-xl font-bold text-blue-900 dark:text-blue-100 mb-3">How to Use</h2>
      <ul class="list-disc list-inside space-y-2 text-blue-800 dark:text-blue-200">
        <li>Enter the employee's hire date and start date of leave</li>
        <li>The calculator will determine FMLA eligibility based on workdays</li>
        <li>View detailed calculations and leave period information</li>
        <li>Export results for documentation purposes</li>
      </ul>
    </div>
  </div>
</BaseLayout>

<script>
  // Track tool usage in localStorage
  function trackToolUsage() {
    const recentTools = JSON.parse(localStorage.getItem('recentTools') || '[]');
    const toolSlug = 'fmla-calculator';
    
    // Remove if already exists
    const filtered = recentTools.filter((slug: string) => slug !== toolSlug);
    
    // Add to beginning
    filtered.unshift(toolSlug);
    
    // Keep only last 5
    const updated = filtered.slice(0, 5);
    
    localStorage.setItem('recentTools', JSON.stringify(updated));
  }

  trackToolUsage();
</script>

<!-- 
  Note: In a future update, we'll integrate the full React-based FMLA Calculator here.
  The existing FMLACalculator app will be mounted into the #fmla-calculator-root div.
-->
