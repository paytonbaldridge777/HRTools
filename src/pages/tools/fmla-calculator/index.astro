---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="FMLA Calculator - HR Tools">
  <div class="container max-w-[1120px] mx-auto px-4 py-12">
    <!-- External FMLA Calculator Link -->
    <div class="bg-[var(--card-bg)] border border-[var(--border-color)] rounded-lg shadow-sm p-12 text-center">
      <h1 class="text-3xl font-bold text-[var(--text-primary)] mb-4">FMLA Calculator</h1>
      <p class="text-lg text-[var(--text-secondary)] mb-8">
        The FMLA Calculator has been moved to a dedicated application for improved performance and features.
      </p>
      <a 
        href="https://paytonbaldridge777.github.io/FMLACalculator/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-tamu-maroon hover:bg-tamu-maroon-700 text-white font-semibold rounded-lg transition-colors shadow-md hover:shadow-lg"
      >
        Open FMLA Calculator
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <!-- Instructions -->
    <div class="mt-8 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-6">
      <h2 class="text-xl font-bold text-blue-900 dark:text-blue-100 mb-3">Features</h2>
      <ul class="list-disc list-inside space-y-2 text-blue-800 dark:text-blue-200">
        <li><strong>Workdays Calculator:</strong> Enter the employee's hire date and start date of leave to determine FMLA eligibility based on workdays</li>
        <li><strong>Approval Email Generator:</strong> Generate an approval email with automatic FMLA hours exhaustion date calculation</li>
        <li>View detailed calculations and leave period information</li>
        <li>Export or copy results for documentation purposes</li>
      </ul>
    </div>
  </div>
</BaseLayout>

<script>
  // Track tool usage in localStorage
  function trackToolUsage() {
    const recentTools = JSON.parse(localStorage.getItem('recentTools') || '[]');
    const toolSlug = 'fmla-calculator';
    
    // Remove if already exists
    const filtered = recentTools.filter((slug: string) => slug !== toolSlug);
    
    // Add to beginning
    filtered.unshift(toolSlug);
    
    // Keep only last 5
    const updated = filtered.slice(0, 5);
    
    localStorage.setItem('recentTools', JSON.stringify(updated));
  }

  trackToolUsage();
</script>
