---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Accessibility Checker - HR Tools">
  <div class="container max-w-[1800px] mx-auto px-4 py-12">
    <!-- Accessibility Checker App Container -->
    <div id="accessibility-root" class="bg-[var(--card-bg)] border border-[var(--border-color)] rounded-lg shadow-sm overflow-hidden">
      <iframe 
        src="/Accessibility/index.html" 
        class="w-full border-0"
        style="min-height: 900px;"
        title="Accessibility Checker Tool"
      ></iframe>
    </div>

    <!-- Instructions -->
    <div class="mt-8 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-6">
      <h2 class="text-xl font-bold text-blue-900 dark:text-blue-100 mb-3">How to Use</h2>
      <ul class="list-disc list-inside space-y-2 text-blue-800 dark:text-blue-200">
        <li>Upload documents (PDF, Word, HTML) or enter a website URL for analysis</li>
        <li>The tool checks for WCAG 2.1 Level AA compliance standards</li>
        <li>Review the generated accessibility report showing all issues found</li>
        <li>Follow the provided recommendations to fix accessibility issues</li>
        <li>Download or print the report for documentation purposes</li>
      </ul>
    </div>
  </div>
</BaseLayout>

<script>
  // Track tool usage in localStorage
  function trackToolUsage() {
    const recentTools = JSON.parse(localStorage.getItem('recentTools') || '[]');
    const toolSlug = 'accessibility-checker';
    
    const filtered = recentTools.filter((slug: string) => slug !== toolSlug);
    filtered.unshift(toolSlug);
    const updated = filtered.slice(0, 5);
    
    localStorage.setItem('recentTools', JSON.stringify(updated));
  }

  trackToolUsage();
</script>
