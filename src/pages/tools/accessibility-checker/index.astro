---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AccessibilityChecker from '../../../components/AccessibilityChecker';
---

<BaseLayout title="Accessibility Checker - HR Tools">
  <div class="container max-w-[1800px] mx-auto px-4 py-12">
    <!-- Accessibility Checker React Component -->
    <div id="accessibility-root">
      <AccessibilityChecker client:load />
    </div>

    <!-- Instructions -->
    <div class="mt-8 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-6">
      <h2 class="text-xl font-bold text-blue-900 dark:text-blue-100 mb-3">How to Use</h2>
      <ul class="list-disc list-inside space-y-2 text-blue-800 dark:text-blue-200">
        <li>Enter a website URL for real-time accessibility analysis</li>
        <li>The tool uses pa11y to check for WCAG 2.1 Level AA compliance</li>
        <li>Review the generated accessibility report showing all issues found</li>
        <li>Each issue includes the WCAG criterion, severity, and location</li>
        <li>Download the HTML report for documentation and sharing</li>
      </ul>
      
      <div class="mt-6 p-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded">
        <h3 class="font-bold text-yellow-900 dark:text-yellow-100 mb-2">⚠️ Server Required</h3>
        <p class="text-sm text-yellow-800 dark:text-yellow-200">
          This tool requires the accessibility scanner server to be running. 
          Start it with: <code class="bg-yellow-100 dark:bg-yellow-900 px-2 py-1 rounded">cd server && npm start</code>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Track tool usage in localStorage
  function trackToolUsage() {
    const recentTools = JSON.parse(localStorage.getItem('recentTools') || '[]');
    const toolSlug = 'accessibility-checker';
    
    const filtered = recentTools.filter((slug) => slug !== toolSlug);
    filtered.unshift(toolSlug);
    const updated = filtered.slice(0, 5);
    
    localStorage.setItem('recentTools', JSON.stringify(updated));
  }

  trackToolUsage();
</script>
